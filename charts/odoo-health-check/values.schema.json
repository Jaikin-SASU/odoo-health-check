{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "target": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "urlFromSecret": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "properties": {
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "strict": {
          "type": "boolean"
        },
        "insecure": {
          "type": "boolean"
        },
        "json": {
          "type": "boolean"
        }
      }
    },
    "schedule": {
      "type": "string",
      "minLength": 1
    },
    "timeZone": {
      "type": "string"
    },
    "suspend": {
      "type": "boolean"
    },
    "concurrencyPolicy": {
      "type": "string",
      "enum": [
        "Allow",
        "Forbid",
        "Replace"
      ]
    },
    "successfulJobsHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "failedJobsHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "backoffLimit": {
      "type": "integer",
      "minimum": 0
    },
    "activeDeadlineSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    }
  }
}
